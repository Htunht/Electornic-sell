// This is your Prisma schema file for the Student Result Management System
// Optimized for PostgreSQL with specific role-based permissions and performance indexing.
// Includes required models for Better-Auth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum Role {
  TEACHER
  STUDENT
}

enum Major {
  CIVIL
  ARCHI
  EP
  EC
  MC
  ME
  IT
}

enum AcademicYear {
  YEAR_1
  YEAR_2
  YEAR_3
  YEAR_4
  YEAR_5
  YEAR_6
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

// --- MODELS ---

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  password       String?   // Nullable for Better-Auth (social logins)
  role           Role      @default(STUDENT)
  
  // Profile Relations
  teacherProfile Teacher?
  studentProfile Student?

  // Better-Auth Required Fields
  name           String
  emailVerified  Boolean   @default(false)
  image          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Better-Auth Relations
  sessions       Session[]
  accounts       Account[]
  
  banned        Boolean   @default(false)
  banReason     String?
  banExpires    DateTime?

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Teacher {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // A teacher is assigned to exactly one major
  major          Major
  
  // Capabilities
  assignments    SubjectAssignment[]
  questionPapers QuestionPaper[]
  results        Result[]
  attendance     Attendance[]

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("teachers")
}

model Student {
  id          String       @id @default(cuid())
  userId      String       @unique
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rollNo      String       @unique
  name        String
  major       Major
  year        AcademicYear
  phoneNumber String?
  address     String?
  
  // Capabilities
  submissions Submission[]
  results     Result[]
  attendance  Attendance[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Performance Optimization for 2,000+ students
  @@index([major, year])
  @@map("students")
}

model Subject {
  id             String          @id @default(cuid())
  code           String          @unique // e.g., "IT-3101-S1"
  name           String
  major          Major
  year           AcademicYear
  semester       Int             @default(1) // 1 = Semester 1, 2 = Semester 2
  creditHours    Int             @default(3)
  
  assignments    SubjectAssignment[]
  questionPapers QuestionPaper[]
  submissions    Submission[]
  results        Result[]
  attendance     Attendance[]

  // Indexing for faster subject lookups per major/year/semester
  @@index([major, year, semester])
  @@map("subjects")
}

model SubjectAssignment {
  id        String       @id @default(cuid())

  teacherId String
  teacher   Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  major     Major
  year      AcademicYear

  canEdit   Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Teacher-specific uniqueness (prevents duplicates for same teacher)
  @@unique([teacherId, subjectId, major, year])

  // Business rule: one teacher per subject per class (major+year)
  @@unique([subjectId, major, year])

  @@index([teacherId])
  @@index([major, year])
  @@map("subject_assignments")
}

model QuestionPaper {
  id        String   @id @default(cuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  
  pdfUrl    String   // URL to the PDF file
  
  // Denormalized for fast filtering by teacher scope
  major     Major
  year      AcademicYear

  createdAt DateTime @default(now())

  @@index([major, year])
  @@map("question_papers")
}

model Submission {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  pdfUrl      String   // URL to the submitted PDF
  
  // Denormalized for fast filtering
  major       Major
  year        AcademicYear

  submittedAt DateTime @default(now())

  // Ensure "single PDF Answer File per subject" per student
  @@unique([studentId, subjectId])
  @@index([major, year])
  @@map("submissions")
}

model Result {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  
  marks     Float
  grade     String   // e.g., "A", "B+", "F"
  semester  Int      @default(1)
  academicYear String @default("2025-2026")
  
  // Denormalized for fast filtering
  major     Major
  year      AcademicYear

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One result per student per subject
  @@unique([studentId, subjectId])
  @@index([major, year])
  @@map("results")
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])

  subjectId String
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  teacherId String?
  teacher   Teacher?         @relation(fields: [teacherId], references: [id])

  date      DateTime         @default(now())
  status    AttendanceStatus @default(PRESENT)

  // Denormalized
  major     Major?
  year      AcademicYear?

  @@index([studentId, date])
  @@index([major, year, date])
  @@unique([studentId, date, subjectId])
  @@map("attendance")
}
